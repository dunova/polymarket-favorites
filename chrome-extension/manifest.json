{
  "manifest_version": 3,
  "name": "Polymarket Favorites",
  "version": "1.2.0",
  "description": "In-page favorites sidebar for Polymarket. Save markets and traders with notes, tags, search, and local-only storage.",
  "author": "Polymarket Toolbox",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://polymarket.com/*",
    "https://*.polymarket.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
